# Bot token (from @BotFather) — used for the control bot and for bot-mode sending
TELEGRAM_BOT_TOKEN=123456789:ABCDefGhIJKlmNoPQRsTUVwxYZ

# Comma-separated Telegram user IDs allowed to control the bot.
# Leave empty to allow everyone (not recommended for production).
ADMIN_IDS=123456789,987654321

# Path to folder with tdata account subfolders (user mode)
ACCOUNTS_DIR=accounts

# Delay in seconds between each sent message
SEND_DELAY=0.5

# How many retries on network/flood errors
MAX_RETRIES=3

# Send a progress update every N messages
PROGRESS_EVERY=10
